{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ecommerce-shop-identity",
    "Audience": "ecommerce-shop",
    "SigningKey": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "RateLimiting": {
    "PermitsPerWindow": 120,
    "AuthPermitsPerMinute": 10
  },
  "ReverseProxy": {
    "Routes": {
      "auth-login": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{action:regex(^(login|register|refresh)$)}"
        },
        "RateLimiterPolicy": "auth"
      },
      "auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "RateLimiterPolicy": "per-ip"
      },
      "users": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        },
        "RateLimiterPolicy": "per-ip",
        "AuthorizationPolicy": "admin"
      },
      "categories": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        },
        "RateLimiterPolicy": "per-ip"
      },
      "products": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        },
        "RateLimiterPolicy": "per-ip"
      },
      "cart": {
        "ClusterId": "cart",
        "Match": {
          "Path": "/api/cart/{**catch-all}"
        },
        "RateLimiterPolicy": "per-ip",
        "AuthorizationPolicy": "authenticated"
      },
      "orders": {
        "ClusterId": "orders",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        },
        "RateLimiterPolicy": "per-ip",
        "AuthorizationPolicy": "authenticated"
      },
      "admin": {
        "ClusterId": "orders",
        "Match": {
          "Path": "/api/admin/{**catch-all}"
        },
        "RateLimiterPolicy": "per-ip",
        "AuthorizationPolicy": "admin"
      },
      "payments": {
        "ClusterId": "payments",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        },
        "RateLimiterPolicy": "per-ip"
      },
      "inventory": {
        "ClusterId": "inventory",
        "Match": {
          "Path": "/api/inventory/{**catch-all}"
        },
        "RateLimiterPolicy": "per-ip"
      },
      "emails": {
        "ClusterId": "email",
        "Match": {
          "Path": "/api/emails/{**catch-all}"
        },
        "RateLimiterPolicy": "per-ip",
        "AuthorizationPolicy": "admin"
      },
      "docs-identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/docs/identity/swagger.json"
        },
        "RateLimiterPolicy": "per-ip",
        "Transforms": [
          {
            "PathSet": "/swagger/v1/swagger.json"
          }
        ]
      },
      "docs-catalog": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/docs/catalog/swagger.json"
        },
        "RateLimiterPolicy": "per-ip",
        "Transforms": [
          {
            "PathSet": "/swagger/v1/swagger.json"
          }
        ]
      },
      "docs-orders": {
        "ClusterId": "orders",
        "Match": {
          "Path": "/docs/orders/swagger.json"
        },
        "RateLimiterPolicy": "per-ip",
        "Transforms": [
          {
            "PathSet": "/swagger/v1/swagger.json"
          }
        ]
      },
      "docs-payments": {
        "ClusterId": "payments",
        "Match": {
          "Path": "/docs/payments/swagger.json"
        },
        "RateLimiterPolicy": "per-ip",
        "Transforms": [
          {
            "PathSet": "/swagger/v1/swagger.json"
          }
        ]
      },
      "docs-inventory": {
        "ClusterId": "inventory",
        "Match": {
          "Path": "/docs/inventory/openapi.json"
        },
        "RateLimiterPolicy": "per-ip",
        "Transforms": [
          {
            "PathSet": "/openapi.json"
          }
        ]
      },
      "docs-cart": {
        "ClusterId": "cart",
        "Match": {
          "Path": "/docs/cart/openapi.json"
        },
        "RateLimiterPolicy": "per-ip",
        "Transforms": [
          {
            "PathSet": "/api-docs/openapi.json"
          }
        ]
      },
      "docs-email": {
        "ClusterId": "email",
        "Match": {
          "Path": "/docs/email/openapi.json"
        },
        "RateLimiterPolicy": "per-ip",
        "Transforms": [
          {
            "PathSet": "/api-docs-json"
          }
        ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5001"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      },
      "catalog": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5002"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      },
      "orders": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5003"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      },
      "payments": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:5004"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      },
      "inventory": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:8001"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      },
      "cart": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:3001"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      },
      "email": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:3002"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      }
    }
  }
}
