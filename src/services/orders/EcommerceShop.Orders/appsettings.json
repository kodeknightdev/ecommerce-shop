{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "OrdersDb": "Host=localhost;Port=5432;Database=orders_db;Username=ecommerceshop;Password=ecommerceshop"
  },
  "Jwt": {
    "Issuer": "ecommerce-shop-identity",
    "Audience": "ecommerce-shop",
    "SigningKey": ""
  },
  "Services": {
    "CatalogGrpc": "http://localhost:5012",
    "Cart": "http://localhost:3001"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Resilience": {
    "RetryCount": 3,
    "TimeoutSeconds": 3,
    "FailuresBeforeBreaking": 5,
    "BreakSeconds": 30,
    "MaxParallelization": 20,
    "MaxQueuedActions": 40
  }
}
