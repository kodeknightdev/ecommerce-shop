<h2 style="margin-top:0;">Thanks for your order!</h2>
<p>We have received your order and are reserving your items now. You will get another email as soon as payment is confirmed.</p>
<table role="presentation" width="100%" cellpadding="6" cellspacing="0" style="border-collapse:collapse;margin:16px 0;">
  <tr style="background:#f4f4f5;text-align:left;"><th>Item</th><th align="center">Qty</th><th align="right">Price</th></tr>
  {{#each items}}
  <tr style="border-bottom:1px solid #e4e4e7;">
    <td>{{name}}</td>
    <td align="center">{{quantity}}</td>
    <td align="right">{{money unitPrice ../currency}}</td>
  </tr>
  {{/each}}
  <tr><td colspan="2" align="right"><strong>Total</strong></td><td align="right"><strong>{{money total currency}}</strong></td></tr>
</table>
<p><a href="{{orderUrl}}" style="background:#0f766e;color:#fff;padding:10px 18px;border-radius:6px;text-decoration:none;">Track your order</a></p>
