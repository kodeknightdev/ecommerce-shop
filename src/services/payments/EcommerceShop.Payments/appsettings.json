{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PaymentsDb": "Host=localhost;Port=5432;Database=payments_db;Username=ecommerceshop;Password=ecommerceshop"
  },
  "Jwt": {
    "Issuer": "ecommerce-shop-identity",
    "Audience": "ecommerce-shop",
    "SigningKey": ""
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "localhost:9094",
    "GroupId": "payments"
  },
  "Outbox": {
    "PollIntervalMs": 1000,
    "BatchSize": 50
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
