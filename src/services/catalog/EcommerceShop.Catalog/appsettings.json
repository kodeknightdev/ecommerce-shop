{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://+:8080",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://+:8081",
        "Protocols": "Http2"
      }
    }
  },
  "ConnectionStrings": {
    "CatalogDb": "Host=localhost;Port=5432;Database=catalog_db;Username=ecommerceshop;Password=ecommerceshop"
  },
  "Jwt": {
    "Issuer": "ecommerce-shop-identity",
    "Audience": "ecommerce-shop",
    "SigningKey": ""
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "localhost:9094",
    "GroupId": "catalog"
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
